# ============================================================
#  Supabase — paste your 3 values from
#  Supabase Dashboard → Project Settings → API
# ============================================================

# Project URL  (looks like https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key  (long eyJ... string — safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key  (long eyJ... string — SECRET, server-only, never expose)
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (Connect → Session pooler) — used only by scripts/migrate.mjs
DATABASE_URL=

# Admin account used by scripts/create-admin.mjs and the e2e suites
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set ONLY on a disposable test project. The m*-e2e scripts delete every loan,
# fine and reservation, and refuse to run unless this matches the project ref
# in NEXT_PUBLIC_SUPABASE_URL. Never set this on production.
ALLOW_DESTRUCTIVE_TESTS=

# Public origin of the deployment, e.g. https://library.aqeelahmed.dev
# Only needed once a custom domain is in front of it — without it the app
# falls back to the URL Vercel assigns, which is correct for *.vercel.app.
NEXT_PUBLIC_SITE_URL=
